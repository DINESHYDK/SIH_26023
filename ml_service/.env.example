GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Set these to this model/account's documented Gemini quotas. The service
# shares one limiter between OCR uploads and streamed answer generation.
GEMINI_RPM=8
GEMINI_RPD=20
# Per-process batch-ingestion workers. Keep scanned ingestion low because it
# makes Vision OCR requests; increase only when your Gemini quota allows it.
MAX_TYPED_INGESTIONS=3
MAX_SCANNED_INGESTIONS=1
PORT=8000
