GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPEN_ROUTER_API_KEY is also accepted for compatibility with existing setups.
GEMINI_MODEL=gemini-2.5-flash
# Tried in order when GEMINI_MODEL keeps returning 503 "high demand".
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
# Scanned pages sent to Vision per API call (fewer calls = less quota/503 exposure).
EXTRACT_BATCH_SIZE=8
# Exponential backoff on 429/5xx/timeouts: delay doubles from BASE up to MAX
# (with jitter, never below the server's retryDelay); a batch gives up after
# RETRY_BUDGET seconds. Keep the budget below the backend's ML_UPLOAD_TIMEOUT_MS.
GEMINI_RETRY_BUDGET_S=300
GEMINI_BASE_BACKOFF_S=2
GEMINI_MAX_BACKOFF_S=60
# Set these to this model/account's documented Gemini quotas. The service
# shares one limiter between OCR uploads and streamed answer generation.
GEMINI_RPM=8
GEMINI_RPD=20
# Per-process batch-ingestion workers. Keep scanned ingestion low because it
# makes Vision OCR requests; increase only when your Gemini quota allows it.
MAX_TYPED_INGESTIONS=3
MAX_SCANNED_INGESTIONS=1
PORT=8000
